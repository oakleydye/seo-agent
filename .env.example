# GitHub API token with repo access for PR creation
GITHUB_TOKEN=ghp_your_token_here

# Portkey API key for LLM gateway (Phase 2+, required for initialization)
PORTKEY_API_KEY=pk_your_portkey_key_here

# Google PageSpeed Insights API key (from Google Cloud Console)
GOOGLE_PAGESPEED_API_KEY=AIza_your_api_key_here

# Optional: path to Google service account JSON for Search Console (Phase 2+)
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
